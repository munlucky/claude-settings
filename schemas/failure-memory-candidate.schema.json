{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/failure-memory-candidate.schema.json",
  "title": "Failure Memory Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "status",
    "failureClass",
    "sourceCommand",
    "evidenceRefs",
    "attemptedFix",
    "replanDelta",
    "appliesTo",
    "doesNotApplyTo"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "ready_for_review", "rejected", "promoted", "superseded"] },
    "failureClass": { "type": "string", "minLength": 1 },
    "sourceCommand": { "type": "string", "minLength": 1 },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "attemptedFix": { "type": "string", "minLength": 1 },
    "replanDelta": { "type": "string", "minLength": 1 },
    "appliesTo": { "type": "array", "items": { "type": "string" } },
    "doesNotApplyTo": { "type": "array", "items": { "type": "string" } },
    "promotionGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiresEvidence": { "const": true },
        "requiresReview": { "const": true },
        "requiresReplay": { "const": true },
        "requiresRollbackPlan": { "const": true },
        "requiresScopeOwner": { "const": true }
      }
    }
  }
}
