{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/awtl-event-v1.schema.json",
  "title": "awtl.event.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "task_id",
    "session_id",
    "run_id",
    "stage",
    "actor",
    "summary",
    "timestamp",
    "ingest_seq",
    "writer_seq",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "span_start",
        "span_end",
        "action",
        "observation",
        "judge_result",
        "artifact_ref",
        "quarantine"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "span_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "action_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ingest_seq": {
      "type": "integer",
      "minimum": 1
    },
    "writer_seq": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "span_start"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "span_id",
              "span_name"
            ],
            "properties": {
              "span_id": {
                "type": "string",
                "minLength": 1
              },
              "span_name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "span_end"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "span_id",
              "span_name"
            ],
            "properties": {
              "span_id": {
                "type": "string",
                "minLength": 1
              },
              "span_name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "action"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "action_name"
            ],
            "properties": {
              "action_name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "observation"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "observation_name"
            ],
            "properties": {
              "observation_name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "judge_result"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "judge_name",
              "result"
            ],
            "properties": {
              "judge_name": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "warn"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "artifact_ref"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "artifact_refs"
            ],
            "properties": {
              "artifact_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "quarantine"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "quarantine_reason",
              "source_path"
            ],
            "properties": {
              "quarantine_reason": {
                "type": "string",
                "minLength": 1
              },
              "source_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  ]
}
