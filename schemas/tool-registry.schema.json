{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moonshot Relay Tool Registry",
  "type": "object",
  "required": ["version", "budget", "selectionPolicy", "groups"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "budget": {
      "type": "object",
      "required": ["minGroups", "maxGroups"],
      "properties": {
        "minGroups": { "type": "integer", "minimum": 1 },
        "maxGroups": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "selectionPolicy": {
      "type": "object",
      "required": [
        "maxSelectedGroups",
        "fallbackGroup",
        "fallbackAuthority",
        "completionAuthority",
        "schemaModeBeforeDispatch",
        "schemaModeAfterDispatch"
      ],
      "properties": {
        "maxSelectedGroups": { "type": "integer", "minimum": 1, "maximum": 3 },
        "fallbackGroup": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "fallbackAuthority": { "enum": ["diagnosis_only"] },
        "completionAuthority": { "const": false },
        "schemaModeBeforeDispatch": { "enum": ["summary"] },
        "schemaModeAfterDispatch": { "enum": ["full"] }
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "minItems": 10,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "summary", "tools"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "summary": { "type": "string", "minLength": 1 },
          "tools": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "summary", "schema"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "summary": { "type": "string", "minLength": 1 },
                "schema": { "type": "object" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
