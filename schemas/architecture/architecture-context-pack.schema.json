{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/architecture/architecture-context-pack.schema.json",
  "title": "Architecture Context Pack",
  "type": "object",
  "additionalProperties": true,
  "required": ["artifactId", "owner", "mode", "evidence", "boundaries"],
  "properties": {
    "artifactId": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["greenfield_prd", "brownfield_codebase"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "observation"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "observation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["ownedPaths", "readOnlyPaths", "stagedPaths"],
      "properties": {
        "ownedPaths": { "type": "array", "items": { "type": "string" } },
        "readOnlyPaths": { "type": "array", "items": { "type": "string" } },
        "stagedPaths": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
