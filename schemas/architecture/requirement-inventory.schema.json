{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/architecture/requirement-inventory.schema.json",
  "title": "Requirement Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "requirements"],
  "properties": {
    "artifactId": { "const": "REQUIREMENT_INVENTORY" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "requirement", "owner", "verificationSignal"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
          "source": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "verificationSignal": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
