{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/architecture/architecture-option.schema.json",
  "title": "Architecture Option",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "options"],
  "properties": {
    "artifactId": { "const": "ARCHITECTURE_OPTIONS" },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "summary", "requirementIds", "asrIds", "verificationSignal"],
        "properties": {
          "id": { "type": "string", "pattern": "^OPT-[0-9]{3,}$" },
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "items": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" } },
          "asrIds": { "type": "array", "items": { "type": "string", "pattern": "^ASR-[0-9]{3,}$" } },
          "verificationSignal": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
