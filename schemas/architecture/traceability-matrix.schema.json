{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/architecture/traceability-matrix.schema.json",
  "title": "Architecture Traceability Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "links"],
  "properties": {
    "artifactId": { "const": "TRACEABILITY_MATRIX" },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirementId", "asrId", "adrId", "verificationSignal", "owner"],
        "properties": {
          "requirementId": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
          "asrId": { "type": "string", "pattern": "^ASR-[0-9]{3,}$" },
          "optionId": { "type": "string", "pattern": "^OPT-[0-9]{3,}$" },
          "adrId": { "type": "string", "pattern": "^ADR-[0-9]{4,}$" },
          "verificationSignal": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
