{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/architecture/c4-model.schema.json",
  "title": "C4 Model Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "level", "elements", "relationships"],
  "properties": {
    "artifactId": { "enum": ["C4_CONTEXT", "C4_CONTAINER", "C4_COMPONENT"] },
    "level": { "enum": ["context", "container", "component"] },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "responsibility"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "responsibility": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relationships": { "type": "array", "items": { "type": "object" } }
  }
}
