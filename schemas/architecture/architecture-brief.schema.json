{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/architecture/architecture-brief.schema.json",
  "title": "Architecture Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "owner", "mode", "purpose", "successCriteria", "constraints"],
  "properties": {
    "artifactId": { "const": "ARCHITECTURE_BRIEF" },
    "owner": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["greenfield_prd", "brownfield_codebase"] },
    "purpose": { "type": "string", "minLength": 1 },
    "successCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "criterion", "verificationSignal"],
        "properties": {
          "id": { "type": "string", "pattern": "^SC-[0-9]{3,}$" },
          "criterion": { "type": "string", "minLength": 1 },
          "verificationSignal": { "type": "string", "minLength": 1 }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } }
  }
}
