{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/architecture/quality-attribute-scenario.schema.json",
  "title": "Quality Attribute Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "scenarios"],
  "properties": {
    "artifactId": { "const": "QUALITY_ATTRIBUTE_SCENARIOS" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "stimulus", "environment", "response", "responseMeasure"],
        "properties": {
          "id": { "type": "string", "pattern": "^QAS-[0-9]{3,}$" },
          "source": { "type": "string", "pattern": "^ASR-[0-9]{3,}$" },
          "stimulus": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "minLength": 1 },
          "response": { "type": "string", "minLength": 1 },
          "responseMeasure": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
