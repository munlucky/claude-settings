{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-relay-kernel.local/schemas/kernel.workflow-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "state",
    "history"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string"
    },
    "state": {
      "enum": [
        "FRAME",
        "EXECUTE",
        "PROVE",
        "CLOSE"
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
