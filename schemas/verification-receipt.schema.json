{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/verification-receipt.schema.json",
  "title": "Verification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "candidate_id", "candidateId", "sourceDigest", "environmentDigest", "status", "commands"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactId": { "const": "VERIFICATION_RECEIPT" },
    "candidate_id": { "$ref": "#/$defs/candidateId" },
    "candidateId": { "$ref": "#/$defs/candidateId" },
    "sourceDigest": { "$ref": "#/$defs/sha256" },
    "environmentDigest": { "$ref": "#/$defs/sha256" },
    "policyDigest": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["passed", "failed", "blocked"] },
    "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/commandEvidence" } }
  },
  "$defs": {
    "candidateId": { "type": "string", "pattern": "^cand_[a-f0-9]{32}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "exitCode", "startedAt", "endedAt"],
      "properties": {
        "argv": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "exitCode": { "type": "integer" },
        "startedAt": { "type": "string", "minLength": 1 },
        "endedAt": { "type": "string", "minLength": 1 },
        "stdoutDigest": { "$ref": "#/$defs/sha256" },
        "stderrDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
