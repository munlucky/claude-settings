{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/harness-switcher.selection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surface", "requestedTrack", "resolvedRoots", "persistence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "surface": { "enum": ["claude_cli", "codex_cli", "codex_desktop", "qwen_cli", "antigravity_desktop"] },
    "requestedTrack": { "enum": ["relay", "kernel"] },
    "effectiveTrack": { "enum": ["relay", "kernel", "unknown"] },
    "resolvedRoots": { "type": "object", "additionalProperties": { "type": "string" } },
    "persistence": { "enum": ["process", "surface_scoped"] },
    "appDataRoot": { "type": ["string", "null"] },
    "receiptId": { "type": "string" }
  }
}
