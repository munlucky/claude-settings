{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/review-critique-loop.schema.json",
  "title": "Review Critique Loop Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "candidate_id",
    "sourceDigest",
    "bundleDigest",
    "effectiveReviewerCount",
    "reviewerIds",
    "iterations",
    "parentResolutions",
    "unresolvedBlockingCount",
    "closeoutEligible",
    "generatedAt",
    "receiptDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactId": { "const": "REVIEW_CRITIQUE_LOOP_RECEIPT" },
    "candidate_id": { "type": "string", "pattern": "^cand_[a-f0-9]{32}$" },
    "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bundleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "effectiveReviewerCount": { "type": "integer", "minimum": 2 },
    "reviewerIds": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "iterations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iteration", "reviewers"],
        "properties": {
          "iteration": { "type": "integer", "minimum": 1, "maximum": 2 },
          "reviewers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reviewerId", "focus"],
              "properties": {
                "reviewerId": { "type": "string", "minLength": 1 },
                "focus": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "parentResolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "status", "evidence", "blockerId"],
        "properties": {
          "findingId": { "type": "string" },
          "status": {
            "enum": ["accepted", "rejected_with_evidence", "deferred_with_blocker", "blocking_tracked"]
          },
          "evidence": { "type": "string" },
          "blockerId": { "type": "string" }
        }
      }
    },
    "unresolvedBlockingCount": { "type": "integer", "minimum": 0 },
    "closeoutEligible": { "type": "boolean" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
