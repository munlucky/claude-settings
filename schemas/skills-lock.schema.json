{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/skills-lock.schema.json",
  "title": "Moonshot Relay Skills Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "skills"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "sourceCommit": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "contentHash", "license", "stages", "permissions"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "permissionReview": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": ["approved", "required", "blocked"]
              },
              "reviewedAt": {
                "type": "string"
              },
              "reviewer": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
