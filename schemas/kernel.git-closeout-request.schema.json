{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KernelGitCloseoutRequest",
  "type": "object",
  "required": [
    "requested",
    "mode",
    "approvedBy",
    "approvalReceipt"
  ],
  "properties": {
    "requested": { "type": "boolean" },
    "mode": {
      "type": "string",
      "enum": [
        "commit",
        "commit_and_push"
      ]
    },
    "approvedBy": { "type": "string" },
    "approvalReceipt": { "type": "string" },
    "message": {
      "type": "string",
      "maxLength": 12000,
      "description": "Optional commit subject and body. The Kernel appends task context to the requested message."
    }
  },
  "additionalProperties": true
}
