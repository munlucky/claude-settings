{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/awtl-failed-turn-case-v1.schema.json",
  "title": "awtl.failed_turn_case.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "created_at",
    "turn_id",
    "failure_turn_id",
    "failure_event_id",
    "artifact_refs",
    "memory_read_node_ids",
    "prevention_hint",
    "applicability",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "failure_turn_id": {
      "type": "string",
      "minLength": 1
    },
    "failure_event_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "memory_read_node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prevention_hint": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "type": "object",
      "required": [
        "scope",
        "run_id",
        "trace_id",
        "failure_type",
        "failure_class"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "failure_type": {
          "type": "string",
          "minLength": 1
        },
        "failure_class": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
