{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/browser-completion-result.schema.json",
  "title": "Moonshot Relay Browser Completion Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "runId",
    "goalId",
    "scenarioId",
    "status",
    "failedStage",
    "failureClass",
    "evidenceDepth",
    "sourceFingerprint",
    "commands",
    "artifacts",
    "repairPromptPath",
    "setupGap",
    "completionAuthority",
    "authoritySource",
    "artifactSha256",
    "generatedAt",
    "producerCommand",
    "staleStatus",
    "runtimeDecisionRef",
    "redactionManifest",
    "taskVerificationClass",
    "criticalSmokeOnlyWarning"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactId": { "const": "BROWSER_COMPLETION_RESULT" },
    "runId": { "type": "string", "minLength": 1 },
    "goalId": { "type": "string", "minLength": 1 },
    "scenarioId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["clean_pass", "flaky_pass", "failed", "setup_gap"] },
    "failedStage": { "type": "string" },
    "failureClass": {
      "enum": [
        "none",
        "static_gate_failed",
        "build_failed",
        "preview_start_failed",
        "fixture_setup_failed",
        "playwright_assertion_failed",
        "browser_confirmation_failed",
        "artifact_missing",
        "runtime_environment_failed",
        "setup_gap",
        "stale_evidence"
      ]
    },
    "evidenceDepth": { "type": "string", "minLength": 1 },
    "sourceFingerprint": { "type": "string" },
    "commands": { "type": "array" },
    "artifacts": { "type": "array" },
    "repairPromptPath": { "type": "string" },
    "setupGap": { "type": "boolean" },
    "completionAuthority": { "const": false },
    "authoritySource": { "const": "evidence_only" },
    "artifactSha256": { "type": "string" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "producerCommand": { "type": "string", "minLength": 1 },
    "staleStatus": { "enum": ["fresh", "stale", "superseded"] },
    "runtimeDecisionRef": { "type": "string" },
    "redactionManifest": { "type": "object" },
    "taskVerificationClass": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "criticalSmokeOnlyWarning": { "type": "boolean" }
  }
}
