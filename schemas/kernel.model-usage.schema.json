{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-relay-kernel.local/schemas/kernel.model-usage.schema.json",
  "title": "Kernel model usage receipt",
  "description": "What the Host actually did with a model route decision. Unknown tokens or cost stay null and are reported as unavailable; they are never recorded as 0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "receiptId", "decisionId", "runId", "hostSurface",
    "actorSessionId", "enforcementStatus", "resultStatus", "createdAt"
  ],
  "allOf": [
    {
      "if": {
        "allOf": [
          { "required": ["enforcementStatus"], "properties": { "enforcementStatus": { "const": "enforced" } } },
          {
            "anyOf": [
              { "required": ["requestedModel"], "properties": { "requestedModel": { "type": "string", "minLength": 1 } } },
              { "required": ["requestedEffort"], "properties": { "requestedEffort": { "type": "string", "minLength": 1 } } },
              { "required": ["observedModel"], "properties": { "observedModel": { "type": "string", "minLength": 1 } } },
              { "required": ["observedEffort"], "properties": { "observedEffort": { "type": "string", "minLength": 1 } } }
            ]
          }
        ]
      },
      "then": { "required": ["resolvedModel", "observedModel"] }
    },
    {
      "if": {
        "allOf": [
          { "required": ["enforcementStatus"], "properties": { "enforcementStatus": { "const": "enforced" } } },
          {
            "anyOf": [
              { "required": ["requestedEffort"], "properties": { "requestedEffort": { "type": "string", "minLength": 1 } } },
              { "required": ["observedEffort"], "properties": { "observedEffort": { "type": "string", "minLength": 1 } } }
            ]
          }
        ]
      },
      "then": { "required": ["observedEffort"] }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptId": { "type": "string", "pattern": "^usage-[a-f0-9]{8,64}$" },
    "decisionId": { "type": "string", "pattern": "^route-[a-f0-9]{8,64}$" },
    "runId": { "type": "string", "minLength": 1 },
    "attemptId": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^attempt-[a-f0-9-]{8,96}$" }] },
    "bindingId": { "type": ["string", "null"] },
    "hostSurface": { "type": "string", "minLength": 1 },
    "actorSessionId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "parentSessionId": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }] },
    "resolvedModel": { "type": ["string", "null"] },
    "resolvedEffort": { "type": ["string", "null"] },
    "requestedModel": { "type": ["string", "null"] },
    "requestedEffort": { "type": ["string", "null"] },
    "observedModel": { "type": ["string", "null"] },
    "observedEffort": { "type": ["string", "null"] },
    "role": { "type": ["string", "null"] },
    "actionKind": { "type": ["string", "null"] },
    "workProfile": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["complexity", "repeatedFailure", "independentContextRequired", "parallelizable"],
      "properties": {
        "complexity": { "enum": ["routine", "standard", "complex", "large-refactor"] },
        "repeatedFailure": { "type": "boolean" },
        "independentContextRequired": { "type": "boolean" },
        "parallelizable": { "type": "boolean" }
      }
    },
    "dispatchMechanism": { "type": ["string", "null"] },
    "enforcementReason": { "type": ["string", "null"] },
    "fallbackReason": { "type": ["string", "null"] },
    "capsuleId": { "type": ["string", "null"] },
    "capsuleDigest": { "type": ["string", "null"] },
    "admissionId": { "type": ["string", "null"] },
    "admissionDigest": { "type": ["string", "null"] },
    "stepId": { "type": ["string", "null"] },
    "enforcementStatus": { "enum": ["enforced", "fallback", "advisory", "unsupported", "failed"] },
    "resultStatus": { "enum": ["completed", "failed", "interrupted", "abandoned"] },
    "startedAt": { "type": ["string", "null"] },
    "finishedAt": { "type": ["string", "null"] },
    "wallClockMs": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "inputTokens": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "cachedInputTokens": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "outputTokens": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "costMicros": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "provider": { "type": ["string", "null"] },
    "surface": { "type": ["string", "null"] },
    "speedMode": { "type": ["string", "null"] },
    "reasoningContext": { "type": ["string", "null"] },
    "reasoningMode": { "type": ["string", "null"] },
    "delegationMode": { "type": ["string", "null"] },
    "sessionLineageId": { "type": ["string", "null"] },
    "previousResponseIdDigest": { "type": ["string", "null"] },
    "promptPrefixDigest": { "type": ["string", "null"] },
    "promptCacheKeyDigest": { "type": ["string", "null"] },
    "cacheMode": { "oneOf": [{ "type": "null" }, { "enum": ["off", "shadow", "on"] }] },
    "cacheTtl": { "type": ["string", "null"] },
    "cacheMissReason": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["cold-prefix", "tool-schema-changed", "common-prefix-changed", "provider-prefix-changed", "project-prefix-changed", "run-prefix-changed", "model-changed", "effort-changed", "speed-mode-changed", "session-reset", "provider-unsupported", "usage-unreported", "unknown"] }
      ]
    },
    "modelEscalationReason": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["risk-tier", "complexity", "repeated-failure", "review-policy", "user-request", "quality-regression", "provider-fallback", "unknown"] }
      ]
    },
    "eligiblePrefixTokens": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "uncachedInputTokens": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "cacheReadInputTokens": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "cacheWriteInputTokens": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "reasoningTokens": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
