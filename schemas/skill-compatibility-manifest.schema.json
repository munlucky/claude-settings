{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/skill-compatibility-manifest.schema.json",
  "title": "Moonshot Relay public skill compatibility manifest",
  "type": "object",
  "required": ["schemaVersion", "sourceFingerprint", "orderedPublicContractHash", "skills"],
  "properties": {
    "schemaVersion": { "const": "moonshot-skill-compatibility.v1" },
    "sourceFingerprint": { "type": "string", "minLength": 1 },
    "orderedPublicContractHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "skills": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["name", "publicPosition", "descriptionIntent", "triggers", "outputArtifacts", "requiredOutputs", "conditionalOutputs", "defaultPaths", "hardStopIds", "policyClauseIds", "sourcePolicyDigest", "completionSemantics", "directInvocationExamples", "contractHash"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "publicPosition": { "type": "integer", "minimum": 0 },
          "descriptionIntent": { "type": "string" },
          "triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "outputArtifacts": { "type": "array", "items": { "type": "string" } },
          "requiredOutputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "conditionalOutputs": { "type": "array", "items": { "type": "string" } },
          "defaultPaths": { "type": "array", "items": { "type": "string" } },
          "hardStopIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "policyClauseIds": { "type": "array", "minItems": 4, "items": { "type": "string" } },
          "sourcePolicyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "completionSemantics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "directInvocationExamples": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "contractHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
