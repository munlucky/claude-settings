{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-relay-kernel.local/schemas/kernel.runtime-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productId",
    "runtimeHome",
    "platform",
    "arch",
    "nodePath",
    "checksum"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "productId": {
      "const": "moon-relay-kernel"
    },
    "runtimeHome": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "arch": {
      "type": "string"
    },
    "nodePath": {
      "type": "string"
    },
    "checksum": {
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
