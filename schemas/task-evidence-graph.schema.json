{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/task-evidence-graph.schema.json",
  "title": "Task Evidence Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "nodes", "edges"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "enum": [
              "Task",
              "Requirement",
              "AcceptanceCriterion",
              "DesignDecision",
              "PlanChunk",
              "CommandRun",
              "TestResult",
              "VerificationResult",
              "Failure",
              "ReviewFinding",
              "Artifact",
              "MemoryFact",
              "Policy"
            ]
          },
          "status": { "type": "string" },
          "stale": { "type": "boolean" },
          "validTo": { "type": ["string", "null"] },
          "supersedes": { "type": "array", "items": { "type": "string" } },
          "blocker": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
