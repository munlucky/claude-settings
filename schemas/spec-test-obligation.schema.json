{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/spec-test-obligation.schema.json",
  "title": "Spec-Test Obligation Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "summary", "items", "obligations", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["pass", "fail"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredItemCount", "obligationCount", "findingCount"],
      "properties": {
        "requiredItemCount": { "type": "integer", "minimum": 0 },
        "obligationCount": { "type": "integer", "minimum": 0 },
        "findingCount": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "itemType", "sourcePath"],
        "properties": {
          "id": { "type": "string" },
          "itemType": { "enum": ["requirement", "scenario", "uat"] },
          "sourcePath": { "type": "string" },
          "criticality": { "type": "string" },
          "uatCritical": { "type": "boolean" },
          "behaviorChanging": { "type": "boolean" },
          "requiredInterface": { "type": "string" },
          "requiredDepth": { "type": "string" },
          "requiredEnvironment": { "type": "string" }
        }
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "verificationMode": {
            "enum": ["tdd_red_green", "characterization_first", "evidence_mandatory", "not_applicable", ""]
          },
          "interface": { "type": "string" },
          "depth": { "type": "string" },
          "environment": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "id", "severity", "message"],
        "properties": {
          "class": {
            "enum": [
              "spec_test_obligation_missing",
              "tdd_red_evidence_missing",
              "tdd_green_evidence_missing",
              "required_spec_test_not_run",
              "critical_scenario_smoke_only",
              "invalid_spec_test_bypass",
              "invalid_depth_interface_combo",
              "characterization_pin_missing",
              "behavior_changing_default_missing",
              "uat_critical_obligation_missing",
              "duplicate_spec_test_obligation"
            ]
          },
          "id": { "type": "string" },
          "severity": { "enum": ["blocking", "warning"] },
          "message": { "type": "string" },
          "sourcePath": { "type": "string" }
        }
      }
    }
  }
}
