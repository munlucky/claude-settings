{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/provider-model-routing.schema.json",
  "title": "Provider Model Routing Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "adapterId", "applicationMode", "applicationSurface", "routeClass", "effortProfile", "reason", "fallback", "tokenEstimateSource", "enforcementEligible", "operatorApprovalRequired"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "adapterId": { "type": "string", "minLength": 1 },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "decisionStatus": { "enum": ["accepted", "rejected", "measurement_unavailable"] },
    "applicationMode": { "enum": ["enforced", "advisory", "unsupported"] },
    "applicationSurface": { "enum": ["per_turn", "child_process", "profile_default", "none"] },
    "routeClass": { "enum": ["mechanical", "normal", "hard_reasoning", "long_context", "critical_review"] },
    "effortProfile": { "enum": ["economy", "standard", "deep", "max"] },
    "selectedModel": { "type": ["string", "null"] },
    "selectedEffort": { "type": ["string", "null"] },
    "reason": { "type": "string", "minLength": 1 },
    "fallback": { "type": ["string", "null"] },
    "contextAction": { "enum": ["none", "compact_or_retrieve", "billing_guard_warning", "explicit_exception_required", "measurement_unavailable"] },
    "tokenEstimateSource": { "enum": ["runtime_authoritative", "caller_supplied", "approximation", "unknown"] },
    "projectedInputTokens": { "type": ["integer", "null"], "minimum": 0 },
    "enforcementEligible": { "type": "boolean" },
    "operatorApprovalRequired": { "type": "boolean" },
    "providerMetadata": { "type": "object", "additionalProperties": true }
  }
}
