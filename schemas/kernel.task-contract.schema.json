{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-relay-kernel.local/schemas/kernel.task-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "objective",
    "acceptance",
    "scope",
    "nonGoals",
    "riskTier"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "riskTier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "surfaces": {
      "type": "array",
      "items": {
        "enum": [
          "security_boundary",
          "data_migration",
          "public_contract",
          "schema_change",
          "runtime_authority",
          "installer"
        ]
      }
    },
    "activeTrack": {
      "enum": [
        "relay",
        "kernel"
      ]
    }
  }
}
