{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/review-receipt.schema.json",
  "title": "Review Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "candidate_id", "candidateId", "sourceDigest", "environmentDigest", "reviewerId", "bundleDigest", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactId": { "const": "REVIEW_RECEIPT" },
    "candidate_id": { "$ref": "#/$defs/candidateId" },
    "candidateId": { "$ref": "#/$defs/candidateId" },
    "sourceDigest": { "$ref": "#/$defs/sha256" },
    "environmentDigest": { "$ref": "#/$defs/sha256" },
    "policyDigest": { "$ref": "#/$defs/sha256" },
    "reviewerId": { "type": "string", "minLength": 1 },
    "bundleDigest": { "$ref": "#/$defs/sha256" },
    "findings": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "candidateId": { "type": "string", "pattern": "^cand_[a-f0-9]{32}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
