{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshot-relay.local/schemas/plan-graph.schema.json",
  "title": "Moonshot Relay Plan Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "phases"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "executionMode": {
      "type": "string",
      "enum": ["markdown-compatible", "graph"]
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "doc", "ownedPaths"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "doc": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "parallelGroup": {
            "type": "string"
          },
          "readOnlyPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "ownedPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptanceEvidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          }
        }
      }
    }
  }
}
